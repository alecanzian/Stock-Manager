# Copy this file to .env and adjust the values for your machine.
# Do not commit .env itself.

POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inventory

POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_CONTAINER_PORT}/${POSTGRES_DB}

BACKEND_CONTAINER_PORT=3001
BACKEND_HOST_PORT=3001

FRONTEND_CONTAINER_PORT=3000
FRONTEND_HOST_PORT=3000
VITE_API_URL=http://localhost:${BACKEND_HOST_PORT}